  "knowledge": [
    {
      "id": "k-gold",
      "kind": "decision",
      "text": "Every mob break pays 1 gold. Trees and hits on armor pay nothing."
    },
    {
      "id": "k-spend",
      "kind": "decision",
      "text": "Gold only buys shop items.",
      "why": "One use keeps the choice simple: which shop, not what to spend on."
    },
    {
      "id": "k-prices",
      "kind": "decision",
      "text": "The 3 shops are cheap (about 3), mid (about 6) and dear (about 10).",
      "why": "Something is always in reach; the dear one is worth saving for."
    },
    {
