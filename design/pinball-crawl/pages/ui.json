  "knowledge": [
    {
      "id": "k-dmd",
      "kind": "decision",
      "text": "A dot-matrix display above the table, like a real backbox, is the whole interface."
    },
    {
      "id": "k-rest",
      "kind": "decision",
      "text": "At rest the display shows score, gold, lives and the current quest; events take it over for a few seconds."
    },
    {
      "id": "k-items",
      "kind": "decision",
      "text": "Each flipper shows its item as a color on the bat; names and details go on the display."
    },
    {
      "id": "k-overlay",
      "kind": "decision",
      "text": "No overlay: if something doesn’t fit the display, simplify the game.",
      "why": "Keeps it a real machine; replaces the earlier overlay fallback."
    },
    {
      "id": "k-boss",
      "kind": "decision",
      "text": "Boss health shows on the toy (plate and lamps), not the display."
    },
    {
      "id": "k-colorblind",
      "kind": "question",
      "text": "Do item colors need a symbol on the bat for color-blind players?"
    },
    {
      "id": "k-hold",
      "kind": "question",
      "text": "How long does an event hold the display?"
    }
  ],
  "agent": {
    "brief": "All information goes through a dot-matrix display above the table (score, gold, lives, quest at rest; events briefly) and through the machine itself: item colors on the bats, plate and lamps on mobs and bosses. There is no overlay.",
    "rules": [
      "Never add an on-screen overlay; simplify instead.",
      "The status line returns after every event."
    ],
    "open": [
      "Color-blind item marks",
      "Event hold time"
    ]
  }
}
