 ],
 "agent": {
  "brief": "The floor every Apply step is checked against. Tokens and components already carry most of it (Color, Type, Controls, Motion, Effects); this page adds the page-level wiring.",
  "rules": [
   "globals.css: --color-text-faint #9783A0 (was #8A7590 in the Color merge map).",
   "Reading frames: Frame variant=\"reading\" → bg-void/60 (Readout, Menu list, Detail, Cori Plate); default stays bg-void/35.",
   "Layout: a \"Skip to content\" link (sr-only until focused) first in body; <nav aria-label=\"Sections\"> for the rail, <main id=\"content\"> for the section, <aside aria-label=\"Links\"> for comms. One <h1> per section = its Frame title; entries use h2.",
   "Rail: role=tablist aria-orientation=horizontal; rail buttons role=tab aria-selected aria-controls=\"content\". Menu list as Containers (tablist, arrows).",
   "Sky <canvas> aria-hidden=\"true\" + one sr-only <p> describing the game; a single polite live region for Cori lines and scanner state (dedupe repeats).",
   "document.title = `${section.title} · Richard Nunez` on every section change (hash). (Metadata in Pages.)",
   "Keys: Esc closes the LINKS Frame and, in play, disengages (confirm only if progress would be lost). PageUp/PageDown = previous/next section.",
   "Check per Apply step: no text token on a ground below 4.5 (table on this page); focus ring visible on every control; tab through the whole page once."
  ],
  "open": []
 }
