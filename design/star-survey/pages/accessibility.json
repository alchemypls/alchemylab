  {
   "id": "t-83",
   "type": "text",
   "x": 56,
   "y": 636,
   "w": 1000,
   "h": 60,
   "text": "text-faint is #9783A0 now (was #8A7590: 3.3 on a bright /35 frame). Reading text sits on /60 frames. Wine is never text. Ember text only on void, surface or /60.",
   "size": 13,
   "weight": 400,
   "font": "sans",
   "color": "#C9B8C4",
