   "align": "left",
   "valign": "top",
   "caps": true
  },
  {
   "id": "t-91",
   "type": "text",
   "x": 1100,
   "y": 716,
   "w": 764,
   "h": 90,
   "text": "Calm mode on prefers-reduced-motion (Motion, Effects): loops stop, fireworks appear open, warp off, glitter/embers ¼, press = flash. Nothing flashes more than 3 times a second.",
   "size": 14,
   "weight": 400,
   "font": "sans",
