 "knowledge": [
  {
   "id": "k-direction",
   "kind": "decision",
   "text": "UI direction: a scientific AR overlay \u2014 minimal, thin lines, corner ticks, leader lines from things to their menus; the game is the scene.",
   "why": "Replaces the tarot / crystal-card idea (2026-11-19): the fireworks, moth and butterfly each have their own style already; the UI should step back."
  },
  {
   "id": "k-frame",
   "kind": "decision",
   "text": "Menus and panels are faint see-through frames: void/35 + signal/6 tint, 4px frost, 1px signal/35 line, square, 12px corner ticks. Bright action items and buttons stand out on them. Reading frames (Readout, Menu list, Detail, Cori's Plate) use void/60 so body and meta text stay \u2265 4.5:1 over the bright nebula (Accessibility); HUD Plates and short readouts stay void/35."
  },
  {
   "id": "k-no-echo",
   "kind": "decision",
   "text": "No mirrored / echo text anywhere; frames and lines carry the AR look."
  },
  {
   "id": "h-menu",
   "kind": "decision",
   "text": "A menu list (index, title, meta; selected = gold) replaces the flip cards, with a leader line from the selected row to its detail frame."
  },
  {
   "id": "h-leaders",
   "kind": "decision",
   "text": "Leader lines: rail dot \u2192 panel, selected row \u2192 detail, orb node \u2192 info bar, Cori \u2192 butterfly, scanner \u2192 target. 1px, 45\u00b0 elbows, signal (gold from a selection)."
  },
  {
   "id": "h-plate",
   "kind": "decision",
   "text": "Plate = a small Frame (8px ticks, px-3 py-2) for HUD readouts and Cori; alive brightens the line and glows."
  },
  {
   "id": "h-press",
   "kind": "hypothesis",
   "text": "On press, a muted firework burst contained in the pressed object (clipped, a few palette sparks, ~500ms); calm mode: a rim flash. \u2192 Effects."
  }
 ],
 "agent": {
  "brief": "Four parts, shared by site and game: Frame, Menu list, Leader line, Plate. Colors, type, spacing, ticks, glow and motion come from the Foundation pages. Card.tsx (7 layers, crystal fill, tarot flip) is replaced, not restyled.",
  "rules": [
   "Frame (shared/ui/containers/Frame.tsx): `relative isolate bg-void/35 (reading frames \u2014 Readout, Menu list, Detail, Cori: bg-void/60) backdrop-blur-xs border border-signal/35 p-4 tablet:p-6` + a wash layer bg-signal/6 + <Ticks size=12 (8 below tablet)>. Optional header: eyebrow (mono micro, signal, tracking-spaced) + title (font-display, text color). Clickable \u2192 hover/focus glow-hover; `alive` \u2192 border-signal/80 + glow-active.",
   "Menu list (replaces flippable Card + deckTabs): role=tablist in a Frame; each row role=tab: mono index (01\u2026), title (font-display bold), meta (mono micro, text-faint). Selected (aria-selected): title gold, 3px gold bar on the left edge, bg-gold/8. Arrow keys move the selection.",
   "Detail: a Frame next to (tablet+) or under (mobile) the menu, `alive` while shown; a gold leader line runs from the selected row to it.",
   "Leader line (shared/ui/Leader.tsx): an SVG path between two anchors measured with getBoundingClientRect (a ResizeObserver keeps it right), 1px, one 45\u00b0 elbow, signal; gold when it starts at a selection; dashed for a drag affordance (orb node \u2192 info bar). Draws in with stroke-dashoffset over DUR.enter; reduced motion: drawn whole. Uses: rail dot \u2192 panel, selected row \u2192 detail, orb node \u2192 info bar, Cori \u2192 butterfly (canvas coords from coriAnchor), scanner \u2192 target star.",
   "Plate: a Frame at small size: 8px ticks, px-3 py-2, no header. GameHUD groups and CoriBubble sit on Plates; Cori's Plate is alive in its mood color while typing.",
   "Delete: gem/Card.tsx flippable mode, the tarot SVG, CrystalChrome, ResponsiveSparkles in cards, Crystal.Corner usage in cards, CornerSpacers (no ornaments to wrap around now).",
   "Press: every Frame row, button and node fires the contained firework preview (Effects decides the look); until Effects is decided, no press effect."
  ],
  "open": [
   "The press burst itself (Effects)"
  ]
 }
}