  "knowledge": [
    {
      "id": "e-drift",
      "kind": "evidence",
      "text": "4 kinds of button: gem/Button (5 variants, colors all undefined var(--btn-*)) used at InfoBar.tsx:37 and GameHUD.tsx:68 (+9 in SilkSandbox); 5 hand-rolled HUD buttons GameHUD.tsx:79-121; rail labels NavBar.tsx:37,96 at text-[6px] md:text-[8px] in #00ffff; raw buttons in NebulaSandbox.tsx:67-80."
    },
    {
      "id": "k-variants",
      "kind": "decision",
      "text": "One Button, two variants: action (gold), quiet (signal line, muted text). Danger was dropped with Reset (dev only).",
      "why": "Covers every real use: the one call to action, the many secondary/HUD buttons, and Reset progress."
    },
    {
      "id": "k-action",
      "kind": "decision",
      "text": "Action is outlined gold: gold/10 tint, 1px gold line, gold text, 8px corner ticks (6 at sm). Ticks on a button mean \"the action\"; quiet has none.",
      "why": "Matches the AR frames; bright without a block of color."
    },
    {
      "id": "k-states",
      "kind": "decision",
      "text": "States: rest no glow · hover glow-hover, brighter text/line · focus 2px signal ring (focus-visible) · press glow-active + contained firework · disabled faint line and text, no ticks, no glow. No scale bounce."
    },
    {
      "id": "k-sizes",
      "kind": "decision",
      "text": "Sizes sm 24 (mono 10) / md 32 (Rajdhani 600 12) / lg 40 (Rajdhani 700 16); 44px hit area on coarse pointers."
    },
